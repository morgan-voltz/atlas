# Préprod Atlas — variables d'environnement (ADR-019).
# Copier en `.env` (gitignoré) et renseigner. NE JAMAIS committer le `.env` ni le dossier `secrets/`.
#
# Les clés sensibles multilignes / volumineuses (PEM JWT, clé AES) ne passent PAS ici :
# elles sont fournies en FICHIERS montés (voir README.md → secrets/). Ce fichier ne contient
# que des valeurs mono-ligne.

# Domaine public de la préprod (DNS A/AAAA -> IP du VPS). Sert au routage Caddy et aux liens d'email.
ATLAS_DOMAIN=atlas-preprod.example.fr

# Email d'enregistrement Let's Encrypt (notifications d'expiration de certificat).
ACME_EMAIL=ops@example.fr

# Mot de passe PostgreSQL (générer une valeur forte, ex. `openssl rand -base64 24`).
POSTGRES_PASSWORD=change-me-strong-password

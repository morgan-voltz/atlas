meta {
  name: 06 INPI Status
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/inpi/connection
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("statut 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("connected = true après Connect", function () {
    const body = res.getBody();
    expect(body).to.have.property("connected");
    expect(body.connected).to.equal(true);
  });
}

docs {

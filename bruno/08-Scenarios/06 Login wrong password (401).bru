meta {
  name: 06 Login wrong password (401)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{freshEmail}}",
    "password": "WrongPassword-999"
  }
}

assert {
  res.status: eq 401
}

docs {
  Le mot de passe est vérifié AVANT l'état du compte → mauvais mot de passe = 401 (invalid_credentials).
}

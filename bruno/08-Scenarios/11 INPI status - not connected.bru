meta {
  name: 11 INPI status - not connected
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/inpi/connection
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

assert {
  res.status: eq 200
}

tests {
  test("connected = false (aucun credential configuré)", function () {
    expect(res.getBody().connected).to.equal(false);
  });
}

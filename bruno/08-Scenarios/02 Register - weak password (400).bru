meta {
  name: 02 Register - weak password (400)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "weak-pwd@atlas.test",
    "password": "short"
  }
}

assert {
  res.status: eq 400
}

docs {
  Mot de passe < 12 caractères → rejeté par FluentValidation avant le handler (400 ProblemDetails).
}

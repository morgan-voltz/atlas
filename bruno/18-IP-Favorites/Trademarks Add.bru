meta {
  name: Trademarks Add
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/favorites/trademarks
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "depositNumber": "{{depositNumber}}",
    "name": "RENAULT"
  }
}

assert {
  res.status: in [204, 409]
}

docs {
  F-018 — Marque une marque INPI en favori (équivalent F-017 pour la PI).
  204 = créé, 409 (`favorites.trademark_already_favorite`) = déjà en favori,
  400 = depositNumber invalide.
  Le `name` est optionnel (snapshot de la dénomination pour l'affichage en liste).
  Renseigner `depositNumber` dans Local.bru.
}

meta {
  name: Enable
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/2fa/enable
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "code": "{{totpCode}}"
  }
}

assert {
  res.status: eq 200
  res.body.recoveryCodes: isDefined
}

docs {
  Active le 2FA après vérification du code TOTP. Renvoie les codes de récupération
  (à conserver). `totpCode` doit être un code valide dérivé du `secret` de « Setup ».
}

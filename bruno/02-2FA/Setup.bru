meta {
  name: Setup
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/2fa/setup
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

vars:post-response {
  totpSecret: res.body.secret
}

assert {
  res.status: eq 200
  res.body.secret: isDefined
}

docs {
  Renvoie `secret` (base32) et `provisioningUri`. Générer un code TOTP à partir du
  secret (app d'authentification ou lib OTP) et le placer dans la variable `totpCode`
  avant « Enable ».
}

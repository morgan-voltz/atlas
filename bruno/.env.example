# Modèle de secrets pour la collection Bruno.
# Copier ce fichier en `.env` (gitignoré) puis renseigner les valeurs.
# Identifiants techniques de l'API INPI, obtenus via data.inpi.fr > « Mes accès API / SFTP ».
# Entourer de quotes simples si la valeur contient des caractères spéciaux ($ % !).
INPI_USERNAME=
INPI_PASSWORD=

meta {
  name: Search
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/trademarks?name=renault&page=1&pageSize=20
  auth: bearer
}

params:query {
  name: renault
  page: 1
  pageSize: 20
}

auth:bearer {
  token: {{accessToken}}
}

assert {
  res.status: eq 200
}

docs {
  Recherche de marques par nom (PI/INPI). Nécessite une connexion INPI active.
  Réponse paginée de résumés { denomination, deposant, depositNumber, ... }.
}

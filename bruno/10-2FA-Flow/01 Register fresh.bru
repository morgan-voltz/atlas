meta {
  name: 01 Register fresh
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{tfaEmail}}",
    "password": "{{tfaPassword}}"
  }
}

script:pre-request {
  bru.setVar("tfaEmail", "tfa-" + Date.now() + "@atlas.test");
  bru.setVar("tfaPassword", "Tfa!Passw0rd-123");
}

tests {
  test("register accepté (200) ou déjà pris (409)", function () {
    expect([200, 409]).to.include(res.getStatus());
  });
}

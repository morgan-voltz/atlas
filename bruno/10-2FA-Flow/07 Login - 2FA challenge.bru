meta {
  name: 07 Login - 2FA challenge
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{tfaEmail}}",
    "password": "{{tfaPassword}}"
  }
}

vars:post-response {
  challengeToken: res.body.challengeToken
}

assert {
  res.status: eq 200
}

tests {
  test("le login renvoie un défi 2FA (pas de jeton direct)", function () {
    expect(res.getBody().twoFactorRequired).to.equal(true);
    expect(res.getBody().challengeToken).to.be.a("string");
    expect(res.getBody().accessToken == null).to.equal(true);
  });
}

{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Hangfire": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimit": {
    "Global": { "PermitLimit": 100, "WindowSeconds": 60 },
    "AuthStrict": { "PermitLimit": 10, "WindowSeconds": 60 }
  },
  "ConnectionStrings": {
    "Atlas": "Host=localhost;Port=5433;Database=atlas;Username=atlas;Password=atlas"
  },
  "Jwt": {
    "Issuer": "atlas",
    "Audience": "atlas",
    "AccessTokenMinutes": 15,
    "PrivateKeyPem": null
  },
  "Auth": {
    "EmailVerificationTokenLifetime": "24:00:00",
    "RefreshTokenLifetime": "30.00:00:00",
    "AccessTokenLifetime": "00:15:00",
    "MaxFailedLoginAttempts": 5,
    "LockoutDuration": "00:15:00"
  },
  "Email": {
    "VerificationBaseUrl": "https://localhost:7201/auth/verify-email"
  },
  "Crypto": {
    "KeyBase64": null
  },
  "Inpi": {
    "RneBaseUrl": "https://registre-national-entreprises.inpi.fr/api/",
    "PiBaseUrl": "https://api-gateway.inpi.fr/",
    "TimeoutSeconds": 30,
    "TokenLifetimeFallback": "01:00:00"
  },
  "Bodacc": {
    "BaseUrl": "https://bodacc-datadila.opendatasoft.com/api/explore/v2.1/catalog/datasets/annonces-commerciales/records",
    "TimeoutSeconds": 30,
    "MaxResultsPerCall": 50
  },
  "Fcm": {
    "ProjectId": null,
    "ServiceAccountJson": null,
    "TimeoutSeconds": 30
  },
  "Apns": {
    "TeamId": null,
    "KeyId": null,
    "PrivateKeyPem": null,
    "BundleId": null,
    "UseSandbox": false,
    "TimeoutSeconds": 30
  }
}

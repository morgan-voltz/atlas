{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5023",
      "https://localhost:7201",
      "http://localhost:5173"
    ]
  },
  "RateLimit": {
    "Global": { "PermitLimit": 10000, "WindowSeconds": 60 },
    "AuthStrict": { "PermitLimit": 1000, "WindowSeconds": 60 }
  }
}

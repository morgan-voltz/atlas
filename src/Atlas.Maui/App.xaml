<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Atlas.Maui"
             x:Class="Atlas.Maui.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Lot 5d : police effective de l'application. Mise à jour à chaud par
                ThemeManager.Apply() selon ThemeManager.FontPreference.
                Référencée par les Setter FontFamily des Style globaux via
                {DynamicResource AppFontFamily}, ce qui propage le swap partout.
            -->
            <x:String x:Key="AppFontFamily">OpenSansRegular</x:String>
        </ResourceDictionary>
    </Application.Resources>
</Application>

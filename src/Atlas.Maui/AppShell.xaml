<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Atlas.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Atlas.Maui.Views"
    FlyoutBehavior="Disabled"
    Title="Atlas">

    <ShellContent
        Route="login"
        ContentTemplate="{DataTemplate views:LoginPage}" />

    <TabBar Route="main">
        <Tab Title="Entreprises">
            <ShellContent ContentTemplate="{DataTemplate views:CompanySearchPage}" />
        </Tab>
        <Tab Title="Historique">
            <ShellContent ContentTemplate="{DataTemplate views:SearchHistoryPage}" />
        </Tab>
    </TabBar>

</Shell>

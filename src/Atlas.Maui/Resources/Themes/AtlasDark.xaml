<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    x:Class="Atlas.Maui.Resources.Themes.AtlasDark">
    <!-- Theme Atlas - dark | genere depuis palettes.py, ne pas editer a la main -->
    <Color x:Key="background">#0D1722</Color>
    <Color x:Key="surface">#16222F</Color>
    <Color x:Key="surfaceVariant">#21303F</Color>
    <Color x:Key="onBackground">#E8EEF4</Color>
    <Color x:Key="onSurface">#E8EEF4</Color>
    <Color x:Key="onSurfaceVariant">#AABBCC</Color>
    <Color x:Key="outline">#5A7490</Color>
    <Color x:Key="primary">#7FB2E0</Color>
    <Color x:Key="onPrimary">#08121C</Color>
    <Color x:Key="primaryContainer">#1E4060</Color>
    <Color x:Key="onPrimaryContainer">#D4E4F4</Color>
    <Color x:Key="success">#5FC98A</Color>
    <Color x:Key="onSuccess">#08121C</Color>
    <Color x:Key="warning">#E0B25C</Color>
    <Color x:Key="onWarning">#08121C</Color>
    <Color x:Key="error">#F08A82</Color>
    <Color x:Key="onError">#08121C</Color>
    <Color x:Key="info">#74C0E8</Color>
    <Color x:Key="onInfo">#08121C</Color>
    <Color x:Key="focus">#8FC4F5</Color>
    <SolidColorBrush x:Key="backgroundBrush" Color="{StaticResource background}" />
    <SolidColorBrush x:Key="surfaceBrush" Color="{StaticResource surface}" />
    <SolidColorBrush x:Key="surfaceVariantBrush" Color="{StaticResource surfaceVariant}" />
    <SolidColorBrush x:Key="onBackgroundBrush" Color="{StaticResource onBackground}" />
    <SolidColorBrush x:Key="onSurfaceBrush" Color="{StaticResource onSurface}" />
    <SolidColorBrush x:Key="onSurfaceVariantBrush" Color="{StaticResource onSurfaceVariant}" />
    <SolidColorBrush x:Key="outlineBrush" Color="{StaticResource outline}" />
    <SolidColorBrush x:Key="primaryBrush" Color="{StaticResource primary}" />
    <SolidColorBrush x:Key="onPrimaryBrush" Color="{StaticResource onPrimary}" />
    <SolidColorBrush x:Key="primaryContainerBrush" Color="{StaticResource primaryContainer}" />
    <SolidColorBrush x:Key="onPrimaryContainerBrush" Color="{StaticResource onPrimaryContainer}" />
    <SolidColorBrush x:Key="successBrush" Color="{StaticResource success}" />
    <SolidColorBrush x:Key="onSuccessBrush" Color="{StaticResource onSuccess}" />
    <SolidColorBrush x:Key="warningBrush" Color="{StaticResource warning}" />
    <SolidColorBrush x:Key="onWarningBrush" Color="{StaticResource onWarning}" />
    <SolidColorBrush x:Key="errorBrush" Color="{StaticResource error}" />
    <SolidColorBrush x:Key="onErrorBrush" Color="{StaticResource onError}" />
    <SolidColorBrush x:Key="infoBrush" Color="{StaticResource info}" />
    <SolidColorBrush x:Key="onInfoBrush" Color="{StaticResource onInfo}" />
    <SolidColorBrush x:Key="focusBrush" Color="{StaticResource focus}" />
</ResourceDictionary>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Atlas.Maui.Views.SearchHistoryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Atlas.Maui.ViewModels"
    xmlns:models="clr-namespace:Atlas.Maui.Models"
    x:DataType="vm:SearchHistoryViewModel"
    Title="Historique">

    <Grid Padding="12" RowDefinitions="Auto,*" RowSpacing="8">

        <ActivityIndicator
            Grid.Row="0"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            Color="{DynamicResource primary}"
            SemanticProperties.Description="Chargement de l'historique" />

        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding Entries}"
            SemanticProperties.Description="Historique des recherches récentes">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:SearchHistoryEntryResponse">
                    <VerticalStackLayout
                        Padding="8"
                        Spacing="2"
                        MinimumHeightRequest="44"
                        SemanticProperties.Description="{Binding Query, StringFormat='Recherche {0}'}">
                        <Label
                            Text="{Binding Query}"
                            FontAttributes="Bold"
                            FontAutoScalingEnabled="True"
                            TextColor="{DynamicResource onSurface}"
                            SemanticProperties.HeadingLevel="Level3" />
                        <Label
                            Text="{Binding Type}"
                            FontSize="12"
                            FontAutoScalingEnabled="True"
                            TextColor="{DynamicResource onSurfaceVariant}"
                            SemanticProperties.Description="{Binding Type, StringFormat='Type de recherche {0}'}" />
                        <Label
                            Text="{Binding CreatedAt}"
                            FontSize="12"
                            FontAutoScalingEnabled="True"
                            TextColor="{DynamicResource onSurfaceVariant}"
                            SemanticProperties.Description="{Binding CreatedAt, StringFormat='Effectuée le {0}'}" />
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>

</ContentPage>

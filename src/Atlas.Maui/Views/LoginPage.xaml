<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Atlas.Maui.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Atlas.Maui.ViewModels"
    x:DataType="vm:LoginViewModel"
    Shell.NavBarIsVisible="False"
    Title="Connexion">

    <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center">

        <Label
            Text="Atlas"
            FontSize="32"
            FontAttributes="Bold"
            FontAutoScalingEnabled="True"
            HorizontalOptions="Center"
            TextColor="{DynamicResource onBackground}"
            SemanticProperties.HeadingLevel="Level1"
            SemanticProperties.Description="Atlas, application de veille entreprise et propriété industrielle" />

        <Entry
            Placeholder="Email"
            Keyboard="Email"
            Text="{Binding Email}"
            FontAutoScalingEnabled="True"
            MinimumHeightRequest="44"
            SemanticProperties.Description="Adresse e-mail de connexion"
            SemanticProperties.Hint="Saisissez l'adresse e-mail associée à votre compte Atlas" />

        <Entry
            Placeholder="Mot de passe"
            IsPassword="True"
            Text="{Binding Password}"
            FontAutoScalingEnabled="True"
            MinimumHeightRequest="44"
            SemanticProperties.Description="Mot de passe"
            SemanticProperties.Hint="Saisissez votre mot de passe ; le contenu reste masqué" />

        <Button
            Text="Se connecter"
            Command="{Binding LoginCommand}"
            FontAutoScalingEnabled="True"
            SemanticProperties.Description="Se connecter à Atlas"
            SemanticProperties.Hint="Valide vos identifiants et ouvre l'application" />

        <ActivityIndicator
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            Color="{DynamicResource primary}"
            SemanticProperties.Description="Connexion en cours" />

        <Label
            Text="{Binding ErrorMessage}"
            IsVisible="{Binding HasError}"
            FontAutoScalingEnabled="True"
            HorizontalOptions="Center"
            TextColor="{DynamicResource error}"
            SemanticProperties.HeadingLevel="Level2"
            SemanticProperties.Description="Message d'erreur de connexion" />

    </VerticalStackLayout>

</ContentPage>

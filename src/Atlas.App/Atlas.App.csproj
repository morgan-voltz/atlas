<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-browserwasm;net10.0-desktop</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>Atlas</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>fr.atlas.app</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>Projet Atlas</ApplicationPublisher>
    <!-- Package Description -->
    <Description>Atlas — client Uno (UI unifiée multi-cible, ADR-029).</Description>

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      SkiaRenderer;
    </UnoFeatures>
  </PropertyGroup>

  <!--
    ADR-002 / ADR-029 : le client ne référence QUE Domain + Shared, jamais
    Infrastructure.* (code décompilable côté client, surtout la tête WASM).
    Verrouillé par Atlas.Architecture.Tests (CsprojDependencyTests).
  -->
  <ItemGroup>
    <ProjectReference Include="..\Atlas.Domain\Atlas.Domain.csproj" />
    <ProjectReference Include="..\Atlas.Shared\Atlas.Shared.csproj" />
  </ItemGroup>

  <!--
    DevEye : shim de dev local (yeux/mains pour Claude via MCP). Reference
    UNIQUEMENT en Debug -> aucune ligne DevEye dans un binaire Release (ni
    desktop ni WASM). Tolere par CsprojDependencyTests (outil debug transverse,
    pas une couche hexagonale).
  -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <ProjectReference Include="..\Atlas.DevEye\Atlas.DevEye.csproj" />
  </ItemGroup>

  <!--
    DI + HttpClientFactory standard .NET (choix U4.1) : versions explicites car le CPM est
    désactivé pour Atlas.App (cf. Directory.Packages.props local). On évite volontairement les
    UnoFeatures Hosting/Http (pile Uno.Extensions) pour rester léger et garder la navigation maison.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <!-- Tête WebAssembly uniquement : extensions fetch (credentials:include) pour joindre le cookie
       HttpOnly de refresh en cross-origin. Le BCL ne fournit pas cette option hors Blazor ; Uno la
       fournit via ce package (namespace Uno.WebAssembly.Net.Http). Cf. BrowserAuthCredentialsHandler. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-browserwasm'">
    <PackageReference Include="Uno.Wasm.HttpRequestMessageExtensions" />
  </ItemGroup>

  <!-- Polices bundlées (doc 16) : référencées via ms-appx dans Styles/Theme.xaml, toutes têtes. -->
  <ItemGroup>
    <Content Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

</Project>

<Project>

  <!--
    Volontairement isolé du Directory.Packages.props racine.

    Le client Uno utilise Uno.Sdk (version figée dans global.json → msbuild-sdks),
    qui fournit les versions de ses *implicit packages*. On laisse donc cette liste
    vide et on DÉSACTIVE le transitive pinning : le CPM strict du repo
    (CentralPackageTransitivePinningEnabled=true) entre sinon en conflit avec les
    centaines de packages transitifs tirés par Uno.Sdk.

    Pour changer la version d'Uno : éditer global.json, pas ce fichier.
    Cf. https://aka.platform.uno/using-uno-sdk — ADR-029, docs/10 §6.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Uno.Sdk gère ses packages implicites ; on ne versionne ici que les packages explicites
         du client (DI + HttpClientFactory standard .NET, U4.1). -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <!-- Extensions fetch WASM (credentials:include pour le cookie de refresh cross-origin). Version
         alignée sur Uno.Wasm.Bootstrap (10.0.96) résolu par Uno.Sdk. Référencé sur la tête WASM seule. -->
    <PackageVersion Include="Uno.Wasm.HttpRequestMessageExtensions" Version="10.0.96" />
    <!-- Tête WASM : Microsoft.Windows.Compatibility (implicite Uno.Sdk) tire System.Security.Cryptography.Xml
         10.0.7, vulnérable (GHSA-23rf-6693-g89p et 4 autres, corrigé en 10.0.10). Pas de transitive pinning
         ici : la version est forcée par une référence directe dans le csproj (tête browserwasm seule). -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.12" />
  </ItemGroup>

</Project>

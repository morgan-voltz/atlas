<Page x:Class="Atlas.App.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:c="using:Atlas.App.Presentation.Controls"
      Background="{ThemeResource AtlasBgBrush}">

  <c:RailShell>
    <ScrollViewer IsTabStop="True" Background="{ThemeResource AtlasBgBrush}">
      <StackPanel Padding="24"
                  Spacing="20"
                  MaxWidth="680"
                  HorizontalAlignment="Center">

        <StackPanel Spacing="4">
          <TextBlock Text="Atlas — kit de composants (Uno)"
                     FontFamily="{ThemeResource AtlasFontHeading}"
                     FontSize="24"
                     Foreground="{ThemeResource AtlasOnSurfaceBrush}" />
          <TextBlock Text="Portage XAML WinUI du kit (U3, ADR-029) : thème, atomes, carte-aperçu, carte-section (4 états), squelettes, et coque rail (NavigationView)."
                     TextWrapping="Wrap"
                     FontSize="13"
                     Foreground="{ThemeResource AtlasOnSurfaceVariantBrush}" />
        </StackPanel>

        <!-- Atomes : Chip (4 tons) -->
        <Border Padding="16" Background="{ThemeResource AtlasSurfaceBrush}" CornerRadius="{ThemeResource AtlasRadiusMd}">
          <StackPanel Spacing="10">
            <TextBlock Text="Chips (tons)" FontWeight="SemiBold" Foreground="{ThemeResource AtlasOnSurfaceBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <c:Chip Text="Diffusion restreinte" Tone="Neutral" />
              <c:Chip Text="SA" Tone="Info" />
              <c:Chip Text="Connecté" Tone="Ok" />
              <c:Chip Text="À reconnecter" Tone="Warn" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Carte-aperçu -->
        <Border Padding="16" Background="{ThemeResource AtlasSurfaceBrush}" CornerRadius="{ThemeResource AtlasRadiusMd}">
          <StackPanel Spacing="2">
            <TextBlock Text="Cartes-aperçu (résultats)" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{ThemeResource AtlasOnSurfaceBrush}" />
            <c:CompanySummaryCard x:Name="Card1" />
            <c:CompanySummaryCard x:Name="Card2" Selected="True" />
            <c:CompanySummaryCard x:Name="Card3" />
            <c:Provenance x:Name="Prov" Source="RNE (INPI)" Separated="True" />
          </StackPanel>
        </Border>

        <!-- Liste en chargement (squelettes) -->
        <Border Padding="16" Background="{ThemeResource AtlasSurfaceBrush}" CornerRadius="{ThemeResource AtlasRadiusMd}">
          <StackPanel Spacing="2">
            <TextBlock Text="Liste en chargement (CardSkeleton)" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{ThemeResource AtlasOnSurfaceBrush}" />
            <c:CardSkeleton />
            <c:CardSkeleton />
          </StackPanel>
        </Border>

        <!-- Cartes-section : les 4 états -->
        <TextBlock Text="Cartes-section (doc 12 §13/§14)" FontWeight="SemiBold" Foreground="{ThemeResource AtlasOnSurfaceBrush}" />

        <c:SectionCard Title="Identité" Source="RNE (INPI)" ShowPin="True" Pinned="True" Indicator="à jour">
          <StackPanel Spacing="8">
            <c:LabeledField Label="Dénomination">Danone</c:LabeledField>
            <c:LabeledField Label="Forme juridique">Société anonyme</c:LabeledField>
            <c:LabeledField Label="SIREN" x:Name="SirenField" />
          </StackPanel>
        </c:SectionCard>

        <c:SectionCard Title="Bilans"
                       State="CoverageEmpty"
                       EmptyMessage="Aucun bilan déposé n'est disponible pour cette entreprise dans le RNE." />

        <c:SectionCard Title="Dirigeants"
                       State="Error"
                       ErrorMessage="Le chargement des dirigeants a échoué." />

        <!-- List-detail à 2 panneaux (doc 14 §3) -->
        <TextBlock Text="List-detail à 2 panneaux (doc 14 §3)" FontWeight="SemiBold" Foreground="{ThemeResource AtlasOnSurfaceBrush}" />
        <Border Padding="16" Background="{ThemeResource AtlasSurfaceBrush}" CornerRadius="{ThemeResource AtlasRadiusMd}">
          <c:ListDetailView x:Name="ListDetail" BackLabel="← Résultats" MinHeight="220">
            <!-- Liste (contenu par défaut) -->
            <StackPanel x:Name="LdList" Spacing="2">
              <c:CompanySummaryCard x:Name="LdCard1" Tapped="OnResultTapped" />
              <c:CompanySummaryCard x:Name="LdCard2" Tapped="OnResultTapped" />
              <c:CompanySummaryCard x:Name="LdCard3" Tapped="OnResultTapped" />
            </StackPanel>
            <c:ListDetailView.DetailContent>
              <c:SectionCard x:Name="LdDetail" Title="Sélectionnez un résultat" Source="RNE (INPI)">
                <c:LabeledField Label="État" x:Name="LdDetailField" />
              </c:SectionCard>
            </c:ListDetailView.DetailContent>
          </c:ListDetailView>
        </Border>

        <!-- Fil de veille (FeedEventCard) -->
        <TextBlock Text="Fil de veille (FeedEventCard)" FontWeight="SemiBold" Foreground="{ThemeResource AtlasOnSurfaceBrush}" />
        <c:FeedEventCard x:Name="Feed1" />
        <c:FeedEventCard x:Name="Feed2" />

      </StackPanel>
    </ScrollViewer>
  </c:RailShell>

</Page>

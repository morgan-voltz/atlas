<Project>

  <!--
    Importe les conventions du repo (métadonnées AGPL, langue neutre), puis assouplit
    ce qui n'a pas de sens pour un projet UI Uno à code XAML généré.
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- Le code-behind XAML et les sources générées par Uno produisent des warnings
         d'analyseurs/style légitimes : on ne les traite pas en erreurs ici
         (même esprit que le code généré ailleurs dans le repo). -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <!-- NU1507 : multiples sources NuGet sous CPM sans source mapping
         NETSDK1201 : RID sans self-contained
         PRI257 : langue par défaut (en) hors ressources incluses
         CA1010/CA1852 : faux positifs sur le code généré par Uno (UserControls partiels, Program)
         CA1001 : Page avec un CancellationTokenSource (search-as-you-type) — disposer un CTS lié à
                  une requête en vol est risqué ; cycle de vie géré par la navigation. -->
    <NoWarn>$(NoWarn);NU1507;NETSDK1201;PRI257;CA1010;CA1852;CA1001;CA1805</NoWarn>
  </PropertyGroup>

</Project>

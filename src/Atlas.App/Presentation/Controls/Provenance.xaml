<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Atlas.App.Presentation.Controls.Provenance"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Atome provenance (doc 12 §4/§13) : la donnée porte toujours sa source, jamais masquée (R6).
       Forme « Source : {source} · {date} ». Separated = filet + marge pour clore un en-tête de fiche. -->
  <StackPanel>
    <Border x:Name="Separator"
            Height="1"
            Margin="0,11,0,7"
            Visibility="Collapsed"
            Background="{ThemeResource AtlasSurfaceVariantBrush}" />
    <TextBlock x:Name="Text"
               FontSize="12"
               Foreground="{ThemeResource AtlasOnSurfaceVariantBrush}" />
  </StackPanel>

</UserControl>

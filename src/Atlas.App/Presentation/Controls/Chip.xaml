<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Atlas.App.Presentation.Controls.Chip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Left"
    VerticalAlignment="Center">

  <!-- Atome puce/badge (doc 12 §11/§12). Le libellé est toujours présent : le ton (couleur + bordure)
       renforce, il ne porte jamais seul l'information (doc 06). -->
  <Border x:Name="Root"
          Padding="9,2"
          BorderThickness="1"
          BorderBrush="Transparent"
          CornerRadius="{StaticResource AtlasRadiusSm}">
    <TextBlock x:Name="Label"
               Text="{x:Bind Text, Mode=OneWay}"
               FontSize="12"
               FontWeight="SemiBold" />

    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="ToneStates">
        <VisualState x:Name="Neutral">
          <VisualState.Setters>
            <Setter Target="Root.Background" Value="Transparent" />
            <Setter Target="Root.BorderBrush" Value="{ThemeResource AtlasOutlineBrush}" />
            <Setter Target="Label.Foreground" Value="{ThemeResource AtlasOnSurfaceVariantBrush}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Info">
          <VisualState.Setters>
            <Setter Target="Root.Background" Value="{ThemeResource AtlasPrimaryContainerBrush}" />
            <Setter Target="Label.Foreground" Value="{ThemeResource AtlasOnPrimaryContainerBrush}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Ok">
          <VisualState.Setters>
            <Setter Target="Root.Background" Value="{ThemeResource AtlasPrimaryContainerBrush}" />
            <Setter Target="Root.BorderBrush" Value="{ThemeResource AtlasPrimaryBrush}" />
            <Setter Target="Label.Foreground" Value="{ThemeResource AtlasOnPrimaryContainerBrush}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Warn">
          <VisualState.Setters>
            <Setter Target="Root.Background" Value="{ThemeResource AtlasErrorContainerBrush}" />
            <Setter Target="Root.BorderBrush" Value="{ThemeResource AtlasErrorOutlineBrush}" />
            <Setter Target="Label.Foreground" Value="{ThemeResource AtlasOnErrorContainerBrush}" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
  </Border>

</UserControl>

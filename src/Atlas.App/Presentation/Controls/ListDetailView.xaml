<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Atlas.App.Presentation.Controls.ListDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- List-detail à deux panneaux (doc 14 §3), la signature desktop. Format large (≥ 880 px) :
       liste à gauche (352 px) + détail à droite. Sous le point de rupture : empilement temporel —
       liste OU détail (si sélection) avec un retour « ← ». Le seuil 880 px fait foi (doc 14 §3). -->
  <Grid x:Name="Root" ColumnSpacing="24" SizeChanged="OnRootSizeChanged">
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="ListColumn" Width="*" />
      <ColumnDefinition x:Name="DetailColumn" Width="0" />
    </Grid.ColumnDefinitions>

    <ContentPresenter x:Name="ListHost"
                      Grid.Column="0"
                      VerticalAlignment="Top"
                      Content="{x:Bind ListContent, Mode=OneWay}" />

    <StackPanel x:Name="DetailHost"
                Grid.Column="1"
                Visibility="Collapsed"
                Spacing="8">
      <HyperlinkButton x:Name="BackButton"
                       Visibility="Collapsed"
                       Click="OnBack"
                       Content="{x:Bind BackLabel, Mode=OneWay}"
                       Foreground="{ThemeResource AtlasOnSurfaceVariantBrush}" />
      <ContentPresenter Content="{x:Bind DetailContent, Mode=OneWay}" />
    </StackPanel>
  </Grid>

</UserControl>

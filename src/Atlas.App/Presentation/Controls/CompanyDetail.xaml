<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Atlas.App.Presentation.Controls.CompanyDetail"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Atlas.App.Presentation.Controls">

  <!-- Fiche entreprise (doc 12 §4) : en-tête d'identité (jamais replié) + cartes-sections.
       Consommateur pur de GET /companies/{siren} (F-004). États : chargement / non-connecté-INPI /
       introuvable / erreur / chargée (doc 12 §14). Le bouton « Suivre » (favoris F-017) viendra ensuite. -->
  <Grid>

    <!-- Chargement -->
    <StackPanel x:Name="LoadingPanel" Spacing="10" Visibility="Collapsed">
      <Border Height="22" Width="220" HorizontalAlignment="Left" CornerRadius="{ThemeResource AtlasRadiusSm}" Background="{ThemeResource AtlasSurfaceVariantBrush}" />
      <Border Height="13" Width="150" HorizontalAlignment="Left" CornerRadius="{ThemeResource AtlasRadiusSm}" Background="{ThemeResource AtlasSurfaceVariantBrush}" />
      <c:SectionCard Title="Dirigeants" State="Skeleton" />
    </StackPanel>

    <!-- Message (non-connecté INPI / introuvable / erreur) -->
    <StackPanel x:Name="MessagePanel" Spacing="8" Visibility="Collapsed">
      <TextBlock x:Name="MessageTitle" FontFamily="{ThemeResource AtlasFontHeading}" FontSize="18"
                 TextWrapping="Wrap" Foreground="{ThemeResource AtlasOnSurfaceBrush}" />
      <TextBlock x:Name="MessageSub" TextWrapping="Wrap" FontSize="13"
                 Foreground="{ThemeResource AtlasOnSurfaceVariantBrush}" />
      <Button x:Name="MessageAction" Visibility="Collapsed" Click="OnMessageAction"
              HorizontalAlignment="Left"
              Foreground="{ThemeResource AtlasOnPrimaryBrush}" Background="{ThemeResource AtlasPrimaryBrush}" />
    </StackPanel>

    <!-- Fiche chargée -->
    <StackPanel x:Name="LoadedPanel" Spacing="14" Visibility="Collapsed">
      <StackPanel Spacing="8">
        <TextBlock x:Name="NameText" FontFamily="{ThemeResource AtlasFontHeading}" FontSize="22"
                   TextWrapping="Wrap" Foreground="{ThemeResource AtlasOnSurfaceBrush}" />
        <StackPanel x:Name="MetaPanel" Orientation="Horizontal" Spacing="8" />
        <StackPanel x:Name="FactsPanel" Spacing="8" />
        <c:Provenance Source="Registre National des Entreprises (INPI)" Separated="True" />
      </StackPanel>

      <c:SectionCard x:Name="DirigeantsSection" Title="Dirigeants"
                     Source="Registre National des Entreprises (INPI)" ShowPin="True" />

      <Border Padding="14" CornerRadius="{ThemeResource AtlasRadiusMd}"
              Background="{ThemeResource AtlasSurfaceBrush}"
              BorderBrush="{ThemeResource AtlasSurfaceVariantBrush}" BorderThickness="1">
        <StackPanel Spacing="4">
          <TextBlock Text="À venir dans Atlas" FontWeight="SemiBold" FontSize="13"
                     Foreground="{ThemeResource AtlasOnSurfaceVariantBrush}" />
          <TextBlock Text="Bilans &amp; finances · BODACC &amp; procédures · Établissements · Propriété industrielle"
                     TextWrapping="Wrap" FontSize="13"
                     Foreground="{ThemeResource AtlasOnSurfaceVariantBrush}" />
        </StackPanel>
      </Border>
    </StackPanel>

  </Grid>

</UserControl>

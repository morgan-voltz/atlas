<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Atlas.App.Presentation.Controls.SectionCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Atlas.App.Presentation.Controls">

  <!-- Carte-section repliable de la fiche (doc 12 §13/§14). En-tête = bouton qui replie/déploie ;
       corps à 4 états (déployé/squelette/vide-couverture/erreur). La provenance vit dans le corps. -->
  <Grid>
    <Border x:Name="Root"
            Background="{ThemeResource AtlasSurfaceBrush}"
            BorderBrush="{ThemeResource AtlasSurfaceVariantBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource AtlasRadiusLg}">
      <StackPanel>

        <!-- En-tête -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Button x:Name="ToggleButton"
                  Grid.Column="0"
                  Click="OnToggle"
                  Background="Transparent"
                  BorderThickness="0"
                  Padding="16,11"
                  MinHeight="44"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch"
                  AutomationProperties.Name="{x:Bind Title, Mode=OneWay}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <TextBlock x:Name="Chevron"
                         Grid.Column="0"
                         Text="▸"
                         FontSize="14"
                         Margin="0,0,10,0"
                         VerticalAlignment="Center"
                         Foreground="{ThemeResource AtlasOnSurfaceVariantBrush}"
                         RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                  <RotateTransform x:Name="ChevronRotation" Angle="0" />
                </TextBlock.RenderTransform>
              </TextBlock>

              <TextBlock Grid.Column="1"
                         Text="{x:Bind Title, Mode=OneWay}"
                         FontFamily="{ThemeResource AtlasFontHeading}"
                         FontSize="16"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center"
                         Foreground="{ThemeResource AtlasOnSurfaceBrush}" />

              <Border x:Name="IndicatorChip"
                      Grid.Column="2"
                      Visibility="Collapsed"
                      VerticalAlignment="Center"
                      Padding="8,2"
                      CornerRadius="{ThemeResource AtlasRadiusSm}"
                      Background="{ThemeResource AtlasSurfaceVariantBrush}">
                <TextBlock x:Name="IndicatorText"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource AtlasOnSurfaceVariantBrush}" />
              </Border>
            </Grid>
          </Button>

          <Button x:Name="PinButton"
                  Grid.Column="1"
                  Visibility="Collapsed"
                  Click="OnPin"
                  Background="Transparent"
                  BorderThickness="0"
                  MinWidth="44"
                  VerticalAlignment="Stretch"
                  Content="📌" />
        </Grid>

        <!-- Corps (un seul état visible à la fois) -->
        <Grid x:Name="Body" Padding="16,4,16,16">

          <!-- Loaded -->
          <StackPanel x:Name="LoadedView" Spacing="8">
            <ContentPresenter Content="{x:Bind SectionContent, Mode=OneWay}" />
            <c:Provenance x:Name="BodyProvenance" Visibility="Collapsed" />
          </StackPanel>

          <!-- Skeleton -->
          <StackPanel x:Name="SkeletonView" Visibility="Collapsed" Spacing="8">
            <TextBlock Text="Chargement…" FontSize="13"
                       Foreground="{ThemeResource AtlasOnSurfaceVariantBrush}" />
            <Border Height="13" CornerRadius="{ThemeResource AtlasRadiusSm}"
                    Background="{ThemeResource AtlasSurfaceVariantBrush}" />
            <Border Height="13" Width="160" HorizontalAlignment="Left"
                    CornerRadius="{ThemeResource AtlasRadiusSm}"
                    Background="{ThemeResource AtlasSurfaceVariantBrush}" />
          </StackPanel>

          <!-- Vide de couverture -->
          <TextBlock x:Name="CoverageView"
                     Visibility="Collapsed"
                     FontSize="14"
                     FontStyle="Italic"
                     TextWrapping="Wrap"
                     Foreground="{ThemeResource AtlasOnSurfaceVariantBrush}" />

          <!-- Erreur locale -->
          <Border x:Name="ErrorView"
                  Visibility="Collapsed"
                  Padding="14,11"
                  Background="{ThemeResource AtlasErrorContainerBrush}"
                  BorderBrush="{ThemeResource AtlasErrorOutlineBrush}"
                  BorderThickness="1"
                  CornerRadius="{ThemeResource AtlasRadiusMd}">
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="ErrorText"
                         Grid.Column="0"
                         TextWrapping="Wrap"
                         VerticalAlignment="Center"
                         FontSize="14"
                         Foreground="{ThemeResource AtlasOnErrorContainerBrush}" />
              <Button x:Name="RetryButton"
                      Grid.Column="1"
                      Content="Réessayer"
                      Click="OnRetry"
                      Foreground="{ThemeResource AtlasOnPrimaryBrush}"
                      Background="{ThemeResource AtlasPrimaryBrush}" />
            </Grid>
          </Border>

        </Grid>
      </StackPanel>
    </Border>

    <!-- Barre d'accent (épinglé) -->
    <Rectangle x:Name="PinAccent"
               Width="3"
               HorizontalAlignment="Left"
               VerticalAlignment="Stretch"
               Visibility="Collapsed"
               Fill="{ThemeResource AtlasPrimaryBrush}" />
  </Grid>

</UserControl>

<Page x:Class="Atlas.App.Presentation.Pages.FavorisPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:c="using:Atlas.App.Presentation.Controls"
      Background="{ThemeResource AtlasBgBrush}">
  <Grid Padding="24" RowSpacing="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
      <TextBlock Text="Favoris"
                 FontFamily="{ThemeResource AtlasFontHeading}"
                 FontSize="24"
                 Foreground="{ThemeResource AtlasOnSurfaceBrush}" />
      <TextBlock x:Name="Count"
                 VerticalAlignment="Bottom" Margin="0,0,0,4"
                 FontSize="13"
                 Foreground="{ThemeResource AtlasOnSurfaceVariantBrush}" />
    </StackPanel>

    <c:ListDetailView x:Name="ListDetail" Grid.Row="1" BackLabel="← Favoris">
      <StackPanel x:Name="ListRoot" Spacing="2">
        <StackPanel x:Name="StatusPanel" Spacing="8" Margin="0,4">
          <TextBlock x:Name="StatusText" Visibility="Collapsed" TextWrapping="Wrap" FontSize="14"
                     Foreground="{ThemeResource AtlasOnSurfaceVariantBrush}" />
          <Button x:Name="RetryButton" Visibility="Collapsed" Content="Réessayer" Click="OnRetry"
                  HorizontalAlignment="Left"
                  Foreground="{ThemeResource AtlasOnPrimaryBrush}" Background="{ThemeResource AtlasPrimaryBrush}" />
        </StackPanel>
        <StackPanel x:Name="Results" Spacing="2" />
      </StackPanel>
      <c:ListDetailView.DetailContent>
        <c:CompanyDetail x:Name="Detail" />
      </c:ListDetailView.DetailContent>
    </c:ListDetailView>
  </Grid>
</Page>

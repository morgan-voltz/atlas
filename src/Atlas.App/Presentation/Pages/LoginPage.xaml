<Page x:Class="Atlas.App.Presentation.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource AtlasBgBrush}">
  <Grid>
    <Border MaxWidth="380"
            Margin="24"
            Padding="28"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{ThemeResource AtlasSurfaceBrush}"
            BorderBrush="{ThemeResource AtlasSurfaceVariantBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource AtlasRadiusLg}">
      <StackPanel Spacing="14">
        <TextBlock Text="Atlas"
                   FontFamily="{ThemeResource AtlasFontHeading}"
                   FontSize="28"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Foreground="{ThemeResource AtlasOnSurfaceBrush}" />
        <TextBlock Text="Connectez-vous à votre compte."
                   FontSize="13"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,4"
                   Foreground="{ThemeResource AtlasOnSurfaceVariantBrush}" />

        <TextBox x:Name="EmailBox"
                 Header="Adresse e-mail"
                 InputScope="EmailNameOrAddress"
                 PlaceholderText="vous@exemple.fr" />

        <PasswordBox x:Name="PasswordBox"
                     Header="Mot de passe"
                     PlaceholderText="••••••••" />

        <TextBlock x:Name="ErrorText"
                   Visibility="Collapsed"
                   TextWrapping="Wrap"
                   FontSize="13"
                   Foreground="{ThemeResource AtlasOnErrorContainerBrush}" />

        <Button x:Name="LoginButton"
                Content="Se connecter"
                Click="OnLoginClick"
                HorizontalAlignment="Stretch"
                Foreground="{ThemeResource AtlasOnPrimaryBrush}"
                Background="{ThemeResource AtlasPrimaryBrush}" />

        <ProgressRing x:Name="Busy"
                      IsActive="False"
                      Visibility="Collapsed"
                      HorizontalAlignment="Center" />
      </StackPanel>
    </Border>
  </Grid>
</Page>

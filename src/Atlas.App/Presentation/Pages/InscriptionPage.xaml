<Page x:Class="Atlas.App.Presentation.Pages.InscriptionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource AtlasBgBrush}">
  <Grid>
    <Border MaxWidth="380"
            Margin="24"
            Padding="28"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{ThemeResource AtlasSurfaceBrush}"
            BorderBrush="{ThemeResource AtlasSurfaceVariantBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource AtlasRadiusLg}">
      <StackPanel Spacing="14">
        <TextBlock Text="Créer un compte"
                   FontFamily="{ThemeResource AtlasFontHeading}"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Foreground="{ThemeResource AtlasOnSurfaceBrush}" />

        <TextBlock Text="Un e-mail de vérification vous sera envoyé. Vous pourrez ensuite connecter votre compte INPI — ou le faire plus tard."
                   FontSize="13" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                   Foreground="{ThemeResource AtlasOnSurfaceVariantBrush}" />

        <TextBox x:Name="EmailBox" Header="Adresse e-mail" InputScope="EmailNameOrAddress" PlaceholderText="vous@cabinet.fr" />

        <StackPanel Spacing="4">
          <PasswordBox x:Name="PasswordBox" Header="Mot de passe" PlaceholderText="••••••••" />
          <TextBlock Text="Au moins 12 caractères."
                     FontSize="12"
                     Foreground="{ThemeResource AtlasOnSurfaceVariantBrush}" />
        </StackPanel>

        <TextBlock x:Name="ErrorText" Visibility="Collapsed" TextWrapping="Wrap" FontSize="13"
                   Foreground="{ThemeResource AtlasOnErrorContainerBrush}" />

        <Button x:Name="SubmitButton" Content="Créer mon compte" Click="OnSubmitClick"
                HorizontalAlignment="Stretch"
                Foreground="{ThemeResource AtlasOnPrimaryBrush}" Background="{ThemeResource AtlasPrimaryBrush}" />

        <ProgressRing x:Name="Busy" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Center" />

        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
          <TextBlock Text="Déjà un compte ?" FontSize="13" VerticalAlignment="Center"
                     Foreground="{ThemeResource AtlasOnSurfaceVariantBrush}" />
          <HyperlinkButton Content="Se connecter" Click="OnGoToLogin" Padding="2,0"
                           Foreground="{ThemeResource AtlasPrimaryBrush}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Page>

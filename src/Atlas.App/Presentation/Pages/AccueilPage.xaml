<Page x:Class="Atlas.App.Presentation.Pages.AccueilPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource AtlasBgBrush}">
  <ScrollViewer>
    <StackPanel Padding="24" Spacing="12" MaxWidth="720" HorizontalAlignment="Stretch">
      <TextBlock Text="Accueil"
                 FontFamily="{ThemeResource AtlasFontHeading}"
                 FontSize="24"
                 Foreground="{ThemeResource AtlasOnSurfaceBrush}" />
      <TextBlock Text="Les mouvements des entités que vous suivez."
                 FontSize="13"
                 Margin="0,0,0,8"
                 Foreground="{ThemeResource AtlasOnSurfaceVariantBrush}" />
      <StackPanel x:Name="Feed" Spacing="0" />
      <TextBlock Text="Vous êtes à jour."
                 FontSize="13"
                 Margin="0,8,0,0"
                 HorizontalAlignment="Center"
                 Foreground="{ThemeResource AtlasOnSurfaceVariantBrush}" />
    </StackPanel>
  </ScrollViewer>
</Page>

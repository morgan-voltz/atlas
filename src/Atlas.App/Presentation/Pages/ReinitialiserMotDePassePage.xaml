<Page x:Class="Atlas.App.Presentation.Pages.ReinitialiserMotDePassePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource AtlasBgBrush}">
  <Grid>
    <Border MaxWidth="380"
            Margin="24"
            Padding="28"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{ThemeResource AtlasSurfaceBrush}"
            BorderBrush="{ThemeResource AtlasSurfaceVariantBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource AtlasRadiusLg}">
      <StackPanel Spacing="14">

        <!-- Formulaire (lien valide) -->
        <StackPanel x:Name="FormPanel" Spacing="14" Visibility="Collapsed">
          <TextBlock Text="Nouveau mot de passe"
                     FontFamily="{ThemeResource AtlasFontHeading}" FontSize="24" FontWeight="Bold"
                     HorizontalAlignment="Center" Foreground="{ThemeResource AtlasOnSurfaceBrush}" />
          <StackPanel Spacing="4">
            <PasswordBox x:Name="PasswordBox" Header="Nouveau mot de passe" PlaceholderText="••••••••" />
            <TextBlock Text="Au moins 12 caractères."
                       FontSize="12" Foreground="{ThemeResource AtlasOnSurfaceVariantBrush}" />
          </StackPanel>
          <TextBlock x:Name="ErrorText" Visibility="Collapsed" TextWrapping="Wrap" FontSize="13"
                     Foreground="{ThemeResource AtlasOnErrorContainerBrush}" />
          <Button x:Name="SubmitButton" Content="Réinitialiser" Click="OnSubmitClick"
                  HorizontalAlignment="Stretch"
                  Foreground="{ThemeResource AtlasOnPrimaryBrush}" Background="{ThemeResource AtlasPrimaryBrush}" />
          <ProgressRing x:Name="Busy" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Center" />
          <HyperlinkButton Content="Retour à la connexion" Click="OnGoToLogin" HorizontalAlignment="Center"
                           Foreground="{ThemeResource AtlasPrimaryBrush}" />
        </StackPanel>

        <!-- Succès -->
        <StackPanel x:Name="DonePanel" Spacing="14" Visibility="Collapsed">
          <TextBlock Text="Mot de passe réinitialisé ✓"
                     FontFamily="{ThemeResource AtlasFontHeading}" FontSize="22" FontWeight="Bold"
                     HorizontalAlignment="Center" Foreground="{ThemeResource AtlasOnSurfaceBrush}" />
          <TextBlock Text="Votre mot de passe a été mis à jour. Vos autres sessions ont été déconnectées par sécurité."
                     FontSize="13" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                     Foreground="{ThemeResource AtlasOnSurfaceVariantBrush}" />
          <Button Content="Se connecter" Click="OnGoToLogin" HorizontalAlignment="Stretch"
                  Foreground="{ThemeResource AtlasOnPrimaryBrush}" Background="{ThemeResource AtlasPrimaryBrush}" />
        </StackPanel>

        <!-- Lien invalide -->
        <StackPanel x:Name="InvalidPanel" Spacing="14" Visibility="Collapsed">
          <TextBlock Text="Lien invalide"
                     FontFamily="{ThemeResource AtlasFontHeading}" FontSize="22" FontWeight="Bold"
                     HorizontalAlignment="Center" Foreground="{ThemeResource AtlasOnSurfaceBrush}" />
          <TextBlock Text="Ce lien de réinitialisation est incomplet ou invalide."
                     FontSize="13" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"
                     Foreground="{ThemeResource AtlasOnErrorContainerBrush}" />
          <Button Content="Demander un nouveau lien" Click="OnGoToForgot" HorizontalAlignment="Stretch"
                  Foreground="{ThemeResource AtlasOnPrimaryBrush}" Background="{ThemeResource AtlasPrimaryBrush}" />
        </StackPanel>

      </StackPanel>
    </Border>
  </Grid>
</Page>

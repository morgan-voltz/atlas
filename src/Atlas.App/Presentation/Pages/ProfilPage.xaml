<Page x:Class="Atlas.App.Presentation.Pages.ProfilPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:c="using:Atlas.App.Presentation.Controls"
      Background="{ThemeResource AtlasBgBrush}">
  <ScrollViewer>
    <StackPanel Padding="24" Spacing="16" MaxWidth="680">
      <TextBlock Text="Profil"
                 FontFamily="{ThemeResource AtlasFontHeading}"
                 FontSize="24"
                 Foreground="{ThemeResource AtlasOnSurfaceBrush}" />

      <c:SectionCard Title="Compte" Source="Atlas">
        <StackPanel Spacing="8">
          <c:LabeledField Label="Statut INPI">
            <c:Chip Text="Connecté" Tone="Ok" />
          </c:LabeledField>
          <c:LabeledField Label="SIREN test" x:Name="SirenField" />
        </StackPanel>
      </c:SectionCard>

      <c:SectionCard Title="Données &amp; RGPD"
                     State="CoverageEmpty"
                     EmptyMessage="L'export de vos données et le droit à l'effacement seront recâblés à l'API en U4." />

      <TextBlock Text="Kit — chips" FontWeight="SemiBold" Foreground="{ThemeResource AtlasOnSurfaceBrush}" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <c:Chip Text="Diffusion restreinte" Tone="Neutral" />
        <c:Chip Text="SA" Tone="Info" />
        <c:Chip Text="Connecté" Tone="Ok" />
        <c:Chip Text="À reconnecter" Tone="Warn" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>

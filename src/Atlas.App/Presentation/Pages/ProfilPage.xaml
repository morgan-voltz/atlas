<Page x:Class="Atlas.App.Presentation.Pages.ProfilPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:c="using:Atlas.App.Presentation.Controls"
      Background="{ThemeResource AtlasBgBrush}">
  <ScrollViewer>
    <StackPanel Padding="24" Spacing="16" MaxWidth="560">
      <TextBlock Text="Profil"
                 FontFamily="{ThemeResource AtlasFontHeading}"
                 FontSize="24"
                 Foreground="{ThemeResource AtlasOnSurfaceBrush}" />

      <!-- Connexion INPI (F-003) -->
      <c:SectionCard Title="Connexion INPI" Source="INPI">
        <StackPanel Spacing="12">

          <ProgressRing x:Name="StatusBusy" IsActive="True" HorizontalAlignment="Left" />

          <!-- État connecté -->
          <StackPanel x:Name="ConnectedPanel" Spacing="10" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <c:Chip Text="Connecté" Tone="Ok" />
              <TextBlock x:Name="ConnectedDetail"
                         VerticalAlignment="Center"
                         FontSize="13"
                         Foreground="{ThemeResource AtlasOnSurfaceVariantBrush}" />
            </StackPanel>
            <Button x:Name="DisconnectButton"
                    Content="Déconnecter"
                    Click="OnDisconnect"
                    HorizontalAlignment="Left"
                    Background="Transparent"
                    BorderBrush="{ThemeResource AtlasOutlineBrush}"
                    BorderThickness="1"
                    Foreground="{ThemeResource AtlasOnSurfaceVariantBrush}" />
          </StackPanel>

          <!-- Formulaire de connexion -->
          <StackPanel x:Name="FormPanel" Spacing="10" Visibility="Collapsed">
            <TextBlock Text="Connectez votre compte INPI habilité à l'API pour accéder aux données RNE et PI."
                       TextWrapping="Wrap"
                       FontSize="13"
                       Foreground="{ThemeResource AtlasOnSurfaceVariantBrush}" />
            <TextBox x:Name="InpiUser" Header="Identifiant INPI" />
            <PasswordBox x:Name="InpiPass" Header="Mot de passe INPI" />
            <TextBlock x:Name="ErrorText"
                       Visibility="Collapsed"
                       TextWrapping="Wrap"
                       FontSize="13"
                       Foreground="{ThemeResource AtlasOnErrorContainerBrush}" />
            <Button x:Name="ConnectButton"
                    Content="Connecter"
                    Click="OnConnect"
                    HorizontalAlignment="Left"
                    Foreground="{ThemeResource AtlasOnPrimaryBrush}"
                    Background="{ThemeResource AtlasPrimaryBrush}" />
          </StackPanel>

        </StackPanel>
      </c:SectionCard>

      <!-- Compte (preuve Domain.Siren conservée) -->
      <c:SectionCard Title="Compte" Source="Atlas">
        <StackPanel Spacing="12">
          <c:LabeledField Label="SIREN test" x:Name="SirenField" />
          <Button x:Name="LogoutButton"
                  Content="Se déconnecter"
                  Click="OnLogout"
                  HorizontalAlignment="Left"
                  Background="Transparent"
                  BorderBrush="{ThemeResource AtlasOutlineBrush}"
                  BorderThickness="1"
                  Foreground="{ThemeResource AtlasOnSurfaceVariantBrush}" />
        </StackPanel>
      </c:SectionCard>

      <!-- Données & confidentialité (doc 12 §9) — export RGPD (art. 20) puis zone sensible (art. 17). -->
      <c:SectionCard Title="Données &amp; confidentialité" Source="RGPD">
        <StackPanel Spacing="16">

          <StackPanel Spacing="8">
            <TextBlock Text="Exporter mes données"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource AtlasOnSurfaceBrush}" />
            <TextBlock Text="Archive JSON : compte, connexion INPI (statut), historique de recherches (RGPD art. 20)."
                       FontSize="13" TextWrapping="Wrap"
                       Foreground="{ThemeResource AtlasOnSurfaceVariantBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button x:Name="ExportButton"
                      Content="Exporter mes données"
                      Click="OnExport"
                      HorizontalAlignment="Left"
                      Background="Transparent"
                      BorderBrush="{ThemeResource AtlasOutlineBrush}"
                      BorderThickness="1"
                      Foreground="{ThemeResource AtlasOnSurfaceBrush}" />
              <ProgressRing x:Name="ExportBusy" IsActive="False" Visibility="Collapsed" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="ExportMessage" Visibility="Collapsed"
                       FontSize="13" TextWrapping="Wrap"
                       Foreground="{ThemeResource AtlasOnSurfaceVariantBrush}" />
          </StackPanel>

          <!-- Zone sensible : suppression de compte (art. 17), confirmation forte. -->
          <Border Background="{ThemeResource AtlasErrorContainerBrush}"
                  CornerRadius="{ThemeResource AtlasRadiusLg}"
                  Padding="16">
            <StackPanel Spacing="10">
              <TextBlock Text="⚠ Supprimer mon compte"
                         FontWeight="SemiBold"
                         Foreground="{ThemeResource AtlasOnErrorContainerBrush}" />
              <TextBlock Text="Effacement sous 30 jours. Vos données personnelles et vos identifiants INPI sont supprimés ; certaines données de facturation sont conservées et anonymisées (obligation légale). Cette action est irréversible."
                         FontSize="13" TextWrapping="Wrap"
                         Foreground="{ThemeResource AtlasOnErrorContainerBrush}" />

              <Button x:Name="DeleteRevealButton"
                      Content="Supprimer définitivement…"
                      Click="OnRevealDelete"
                      HorizontalAlignment="Left"
                      Background="Transparent"
                      BorderBrush="{ThemeResource AtlasErrorBrush}"
                      BorderThickness="1"
                      Foreground="{ThemeResource AtlasErrorBrush}" />

              <StackPanel x:Name="DeleteConfirmPanel" Spacing="10" Visibility="Collapsed">
                <TextBlock x:Name="ConfirmPrompt"
                           FontSize="13" TextWrapping="Wrap"
                           Foreground="{ThemeResource AtlasOnErrorContainerBrush}" />
                <TextBox x:Name="ConfirmEmailBox" TextChanged="OnConfirmEmailChanged"
                         InputScope="EmailNameOrAddress" />
                <TextBlock x:Name="DeleteError" Visibility="Collapsed"
                           FontSize="13" TextWrapping="Wrap"
                           Foreground="{ThemeResource AtlasOnErrorContainerBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button x:Name="DeleteButton"
                          Content="Supprimer mon compte"
                          Click="OnDelete"
                          IsEnabled="False"
                          Foreground="{ThemeResource AtlasOnErrorBrush}"
                          Background="{ThemeResource AtlasErrorBrush}" />
                  <Button Content="Annuler"
                          Click="OnCancelDelete"
                          Background="Transparent"
                          BorderBrush="{ThemeResource AtlasOutlineBrush}"
                          BorderThickness="1"
                          Foreground="{ThemeResource AtlasOnSurfaceVariantBrush}" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>

        </StackPanel>
      </c:SectionCard>

    </StackPanel>
  </ScrollViewer>
</Page>

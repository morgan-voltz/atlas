@inject IAtlasApiClient Api

@* Détail d'une entreprise — en-tête d'identité + cartes-sections (doc 12 §4). Extrait en composant
   pour être partagé par la page /entreprise/{siren} (M2) ET le panneau droit du list-detail Favoris
   (M4, doc 14 §3). Consommateur pur de GET /companies/{siren} (F-004). Le bouton « Suivre » pilote
   les favoris (F-017) : POST/DELETE /favorites/companies. *@

<div class="company-detail" aria-live="polite" aria-busy="@(state == DetailState.Loading)">
    @if (ShowBackLink)
    {
        <p class="back-link"><a href="recherche">← Recherche</a></p>
    }

    @switch (state)
    {
        case DetailState.Loading:
            <div class="id-header skeleton-header" aria-hidden="true">
                <div class="skeleton-line title"></div>
                <div class="skeleton-line short"></div>
            </div>
            <SectionCard Title="Dirigeants" State="SectionCard.SectionState.Skeleton" />
            <p role="status" class="sr-only">Chargement de la fiche entreprise…</p>
            break;

        case DetailState.NotConnected:
            <div class="degraded" role="status">
                <p class="degraded-title">Connecte ton compte INPI pour voir cette fiche</p>
                <p class="degraded-sub">
                    Les fiches entreprise viennent du Registre National des Entreprises (INPI), accessible
                    avec tes identifiants. Rends-toi sur ton profil pour les renseigner.
                </p>
                <a class="degraded-action" href="profil">Aller au profil</a>
            </div>
            break;

        case DetailState.NotFound:
            <div class="empty-state" role="status">
                <p class="empty-title">Aucune entreprise pour ce SIREN</p>
                <p class="empty-sub">Le SIREN <span class="mono">@FormatSiren(Siren)</span> n'a pas de fiche au RNE.</p>
            </div>
            break;

        case DetailState.Error:
            <div class="page-error" role="alert">
                <p class="page-error-msg">@message</p>
                <button type="button" class="page-retry" @onclick="ReloadAsync">Réessayer</button>
            </div>
            break;

        case DetailState.Loaded when company is not null:
            @* En-tête d'identité — toujours visible, ne se replie jamais (doc 12 §4). *@
            <header class="id-header">
                <div class="id-top">
                    <h2 class="id-name">@company.Denomination</h2>
                    <button type="button" class="follow-btn @(isFavorite ? "on" : null)"
                            @onclick="ToggleFavoriteAsync" disabled="@followBusy"
                            aria-pressed="@isFavorite.ToString().ToLowerInvariant()">
                        @(isFavorite ? "★ Suivi" : "☆ Suivre")
                    </button>
                </div>

                @if (followError is not null)
                {
                    <p class="follow-error" role="alert">@followError</p>
                }

                <p class="id-meta">
                    <span class="mono id-siren">@FormatSiren(company.Siren)</span>
                    @if (!string.IsNullOrWhiteSpace(company.FormeJuridique))
                    {
                        <Chip Tone="Chip.ChipTone.Info">@company.FormeJuridique</Chip>
                    }
                    @if (!company.IsDiffusible)
                    {
                        @* Diffusion restreinte (catégorie 3, doctrine) : fait de couverture, toujours montré. *@
                        <Chip Tone="Chip.ChipTone.Neutral" Title="Diffusion restreinte (INSEE)">Diffusion restreinte</Chip>
                    }
                </p>

                <dl class="id-facts">
                    @if (!string.IsNullOrWhiteSpace(company.NafCode))
                    {
                        <LabeledField Label="Activité (NAF)">
                            <span class="mono">@company.NafCode</span>@(string.IsNullOrWhiteSpace(company.NafLabel) ? null : $" — {company.NafLabel}")
                        </LabeledField>
                    }
                    @if (company.DateCreation is { } created)
                    {
                        <LabeledField Label="Création">@created.ToString("d MMMM yyyy", Culture)</LabeledField>
                    }
                    @if (FormatAddress(company.Adresse) is { } addr)
                    {
                        <LabeledField Label="Siège">@addr</LabeledField>
                    }
                </dl>

                @* Provenance épinglée — ne se replie jamais (garde-fou R6, doc 12 §4). *@
                <Provenance Source="Registre National des Entreprises (INPI)" Separated="true" />
            </header>

            @* Pile de cartes-sections — ordre par défaut doc 12 §4 (MVP : Dirigeants ; le reste à venir). *@
            <SectionCard Title="Dirigeants"
                         Indicator="@(company.Dirigeants.Count > 0 ? company.Dirigeants.Count.ToString() : null)"
                         Source="Registre National des Entreprises (INPI)"
                         State="@(company.Dirigeants.Count == 0 ? SectionCard.SectionState.CoverageEmpty : SectionCard.SectionState.Loaded)"
                         EmptyMessage="@DirigeantsEmptyMessage">
                <ul class="dirigeants-list">
                    @foreach (DirigeantResponse d in company.Dirigeants)
                    {
                        <li class="dirigeant">
                            <span class="dirigeant-nom">@d.Nom</span>
                            @if (!string.IsNullOrWhiteSpace(d.Qualite))
                            {
                                <span class="dirigeant-qualite">@d.Qualite</span>
                            }
                        </li>
                    }
                </ul>
            </SectionCard>

            @* Sections à venir : périmètre Atlas (pas un fait sur l'entreprise), distinctes d'un
               vide-de-couverture. Données réelles avec les features dédiées (Bilans F-013, BODACC, PI). *@
            <div class="upcoming" aria-label="Sections à venir">
                <p class="upcoming-head">À venir dans Atlas web</p>
                <ul class="upcoming-list">
                    <li>Bilans &amp; finances</li>
                    <li>BODACC &amp; procédures</li>
                    <li>Établissements</li>
                    <li>Propriété industrielle</li>
                </ul>
            </div>
            break;
    }
</div>

@code {
    private static readonly System.Globalization.CultureInfo Culture = new("fr-FR");

    [Parameter]
    [EditorRequired]
    public required string Siren { get; set; }

    /// <summary>Affiche le lien de retour « ← Recherche » (page autonome) ; masqué dans le list-detail.</summary>
    [Parameter]
    public bool ShowBackLink { get; set; }

    /// <summary>Remonte l'entreprise chargée (ex. pour le titre de page) ; null si non chargée.</summary>
    [Parameter]
    public EventCallback<CompanyResponse?> OnCompanyLoaded { get; set; }

    /// <summary>Notifie le parent qu'un favori a changé (ajout/retrait), pour rafraîchir une liste.</summary>
    [Parameter]
    public EventCallback OnFavoriteChanged { get; set; }

    private DetailState state = DetailState.Loading;
    private CompanyResponse? company;
    private string? message;
    private string? loadedSiren;
    private bool isFavorite;
    private bool followBusy;
    private string? followError;

    private string DirigeantsEmptyMessage => company?.IsDiffusible == false
        ? "Diffusion restreinte : dirigeants non communiqués (INSEE)."
        : "Aucun dirigeant publié au RNE pour cette entreprise.";

    protected override async Task OnParametersSetAsync()
    {
        // Recharge seulement quand le SIREN change (évite un re-fetch à chaque re-rendu).
        if (Siren != loadedSiren)
        {
            await LoadAsync();
        }
    }

    private Task ReloadAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        state = DetailState.Loading;
        message = null;
        followError = null;
        company = null;
        isFavorite = false;
        loadedSiren = Siren;
        await OnCompanyLoaded.InvokeAsync(null);

        ApiResult<CompanyResponse> result = await Api.GetCompanyBySirenAsync(Siren);
        if (result.IsSuccess)
        {
            company = result.Value;
            state = DetailState.Loaded;
            await OnCompanyLoaded.InvokeAsync(company);
            await RefreshFavoriteStateAsync();
            return;
        }

        state = result.ErrorCode switch
        {
            "companies.not_found" => DetailState.NotFound,
            "inpi.not_connected" => DetailState.NotConnected,
            _ => DetailState.Error,
        };

        if (state == DetailState.Error)
        {
            message = MapError(result.ErrorCode);
        }
    }

    private async Task RefreshFavoriteStateAsync()
    {
        // Les favoris sont en base locale (pas d'INPI) ; un échec ne casse pas la fiche.
        ApiResult<IReadOnlyList<CompanyFavoriteResponse>> favs = await Api.GetMyCompanyFavoritesAsync();
        if (favs.IsSuccess && favs.Value is not null && company is not null)
        {
            isFavorite = favs.Value.Any(f => f.Siren == company.Siren);
        }
    }

    private async Task ToggleFavoriteAsync()
    {
        if (company is null || followBusy)
        {
            return;
        }

        followBusy = true;
        followError = null;

        ApiResult result = isFavorite
            ? await Api.RemoveCompanyFavoriteAsync(company.Siren)
            : await Api.AddCompanyFavoriteAsync(company.Siren, company.Denomination);

        if (result.IsSuccess)
        {
            isFavorite = !isFavorite;
            await OnFavoriteChanged.InvokeAsync();
        }
        else
        {
            followError = "Action impossible pour le moment. Réessayez.";
        }

        followBusy = false;
    }

    private static string MapError(string? code) => code switch
    {
        "companies.invalid_siren" => "SIREN invalide : 9 chiffres avec un contrôle Luhn valide.",
        "unauthorized" => "Votre session a expiré. Reconnectez-vous.",
        "network" => "Service indisponible. Vérifiez votre connexion et réessayez.",
        _ => "Une erreur est survenue pendant le chargement de la fiche. Réessayez.",
    };

    private static string FormatSiren(string siren) =>
        siren.Length == 9 ? $"{siren[..3]} {siren[3..6]} {siren[6..]}" : siren;

    private static string? FormatAddress(AddressResponse? a)
    {
        if (a is null)
        {
            return null;
        }

        string[] parts =
        [
            a.Line ?? string.Empty,
            string.Join(' ', new[] { a.PostalCode, a.City }.Where(s => !string.IsNullOrWhiteSpace(s))),
            a.Country ?? string.Empty,
        ];

        string joined = string.Join(", ", parts.Where(s => !string.IsNullOrWhiteSpace(s)));
        return string.IsNullOrWhiteSpace(joined) ? null : joined;
    }

    private enum DetailState
    {
        Loading,
        Loaded,
        NotFound,
        NotConnected,
        Error,
    }
}

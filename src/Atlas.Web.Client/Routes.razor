@* Routeur du client web Blazor (WASM). Garde de route globale : toute page marquée [Authorize] non
   satisfaite redirige vers /connexion (doc 14 — route protégée). L'app v1 est authentifiée seule. *@
<CascadingAuthenticationState>
    <Router AppAssembly="typeof(AssemblyMarker).Assembly" NotFoundPage="typeof(Pages.NotFound)">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.RailLayout)">
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
                <Authorizing>
                    <p role="status">Chargement…</p>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
    </Router>
</CascadingAuthenticationState>

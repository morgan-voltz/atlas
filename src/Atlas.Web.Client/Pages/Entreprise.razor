@page "/entreprise/{Siren}"
@attribute [Authorize]

@* Page fiche entreprise (M2) — mince enveloppe autour de CompanyDetail (partagé avec le list-detail
   Favoris, M4). Le titre de page reflète la dénomination chargée (doc 14 §5). *@

<PageTitle>@pageTitle</PageTitle>

<div class="fiche-page">
    <CompanyDetail Siren="@Siren" ShowBackLink="true" OnCompanyLoaded="OnCompanyLoaded" />
</div>

@code {
    [Parameter]
    public string Siren { get; set; } = string.Empty;

    private string pageTitle = "Entreprise · Atlas";

    private void OnCompanyLoaded(CompanyResponse? company) =>
        pageTitle = company is not null ? $"{company.Denomination} · Atlas" : "Entreprise · Atlas";
}

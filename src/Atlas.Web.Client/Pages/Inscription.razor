@page "/inscription"
@layout CenteredLayout
@inject IAtlasApiClient Api
@inject NavigationManager Navigation

@* Création de compte (M7, doc 12 §10). Annonce honnête du parcours dès l'inscription : un email de
   vérification sera envoyé, puis la connexion INPI sera proposée (zappable). Aucun palier caché.
   Mot de passe : règle visible (≥ 12 caractères, alignée sur RegisterUserValidator). *@

<PageTitle>Créer un compte · Atlas</PageTitle>

<h1 class="auth-title">Créer un compte</h1>

<p class="auth-intro">
    Un email de vérification vous sera envoyé. Vous pourrez ensuite connecter votre compte INPI
    — ou le faire plus tard.
</p>

<EditForm Model="form" OnValidSubmit="SubmitAsync" class="auth-form">
    <DataAnnotationsValidator />

    @if (message is not null)
    {
        <p class="auth-error" role="alert" aria-live="assertive">@message</p>
    }

    <div class="field">
        <label for="email">Email professionnel</label>
        <InputText id="email" @bind-Value="form.Email" type="email" autocomplete="username"
                   placeholder="vous@cabinet.fr" disabled="@busy" />
        <ValidationMessage For="() => form.Email" />
    </div>

    <div class="field">
        <label for="password">Mot de passe</label>
        <InputText id="password" @bind-Value="form.Password" type="password" autocomplete="new-password"
                   aria-describedby="pwd-rule" disabled="@busy" />
        <p id="pwd-rule" class="field-hint">Au moins 12 caractères.</p>
        <ValidationMessage For="() => form.Password" />
    </div>

    <button type="submit" class="btn-primary" disabled="@busy" aria-busy="@busy">
        @(busy ? "Création…" : "Créer mon compte")
    </button>
</EditForm>

<p class="auth-footer">
    Déjà un compte ? <a href="connexion">Se connecter</a>
</p>

@code {
    private readonly RegisterForm form = new();
    private bool busy;
    private string? message;

    private async Task SubmitAsync()
    {
        busy = true;
        message = null;

        ApiResult result = await Api.RegisterAsync(form.Email, form.Password);

        if (result.IsSuccess)
        {
            // Parcours annoncé : on enchaîne sur l'écran d'attente de vérification d'email.
            Navigation.NavigateTo($"verifier-email?email={Uri.EscapeDataString(form.Email)}", forceLoad: false);
            return;
        }

        message = MapError(result.ErrorCode);
        busy = false;
    }

    private static string MapError(string? code) => code switch
    {
        "users.email_already_in_use" => "Un compte existe déjà avec cette adresse. Connectez-vous.",
        "users.invalid_email" => "Format d'email invalide.",
        "network" => "Service indisponible. Vérifiez votre connexion et réessayez.",
        _ => "La création de compte a échoué. Vérifiez vos informations et réessayez.",
    };

    private sealed class RegisterForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "L'email est requis.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Format d'email invalide.")]
        public string Email { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Le mot de passe est requis.")]
        [System.ComponentModel.DataAnnotations.MinLength(12, ErrorMessage = "Le mot de passe doit contenir au moins 12 caractères.")]
        public string Password { get; set; } = string.Empty;
    }
}

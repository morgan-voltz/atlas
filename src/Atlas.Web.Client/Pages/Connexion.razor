@page "/connexion"
@layout CenteredLayout
@inject IAtlasApiClient Api
@inject AtlasAuthenticationStateProvider AuthState
@inject NavigationManager Navigation

<PageTitle>Se connecter · Atlas</PageTitle>

<h1 class="auth-title">Se connecter</h1>

<EditForm Model="form" OnValidSubmit="SubmitAsync" class="auth-form">
    <DataAnnotationsValidator />

    @if (message is not null)
    {
        <p class="auth-error" role="alert" aria-live="assertive">@message</p>
    }

    <div class="field">
        <label for="email">Email</label>
        <InputText id="email" @bind-Value="form.Email" type="email" autocomplete="username"
                   placeholder="vous@cabinet.fr" disabled="@busy" />
        <ValidationMessage For="() => form.Email" />
    </div>

    <div class="field">
        <label for="password">Mot de passe</label>
        <InputText id="password" @bind-Value="form.Password" type="password" autocomplete="current-password"
                   disabled="@busy" />
        <ValidationMessage For="() => form.Password" />
    </div>

    <button type="submit" class="btn-primary" disabled="@busy" aria-busy="@busy">
        @(busy ? "Connexion…" : "Se connecter")
    </button>
</EditForm>

@* Mot de passe oublié et création de compte : parcours d'onboarding au jalon M7. *@
<p class="auth-secondary">
    <span class="auth-muted" title="Disponible au jalon M7">Mot de passe oublié ?</span>
</p>
<p class="auth-footer">
    Pas de compte ?
    <span class="auth-muted" title="Création de compte au jalon M7">Créer un compte</span>
</p>

@code {
    private readonly LoginForm form = new();
    private bool busy;
    private string? message;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private async Task SubmitAsync()
    {
        busy = true;
        message = null;

        LoginResult result = await Api.LoginAsync(form.Email, form.Password);

        switch (result.Status)
        {
            case LoginStatus.Success:
                AuthState.NotifyUserAuthentication();
                Navigation.NavigateTo(SafeReturnTarget(), forceLoad: false);
                return;
            case LoginStatus.TwoFactorRequired:
                message = "Ce compte utilise la validation en deux étapes (2FA). La vérification 2FA arrivera au jalon M7.";
                break;
            case LoginStatus.InvalidCredentials:
                message = "Email ou mot de passe incorrect.";
                break;
            case LoginStatus.EmailNotVerified:
                message = "Votre adresse email n'a pas encore été vérifiée.";
                break;
            case LoginStatus.AccountLocked:
                message = "Compte temporairement verrouillé après plusieurs tentatives. Réessayez dans quelques minutes.";
                break;
            default:
                message = "Service indisponible pour le moment. Réessayez plus tard.";
                break;
        }

        busy = false;
    }

    private string SafeReturnTarget()
    {
        // N'accepte qu'un chemin relatif interne (anti-open-redirect).
        if (string.IsNullOrEmpty(ReturnUrl) || ReturnUrl.Contains("://", StringComparison.Ordinal) || ReturnUrl.StartsWith("//", StringComparison.Ordinal))
        {
            return "accueil";
        }

        return ReturnUrl;
    }

    private sealed class LoginForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "L'email est requis.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Format d'email invalide.")]
        public string Email { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Le mot de passe est requis.")]
        public string Password { get; set; } = string.Empty;
    }
}
